{
  "name": "JC303 MPC",
  "vendor": "midilab",
  "uid": "JcM3",
  "version": 701,
  "so": "jc303_mpc.so",
  "params": "params.json",
  "layout": "layout.conf",
  "targets": [
    "aarch64"
  ],
  "defines": {
    "ENGINE_FLOAT32": 1,
    "SAMPLE_ACCURATE": 1,
    "HAS_TRANSPORT": 0,
    "HAS_SONG_POS": 1,
    "PARAM_TEXT_MAX": 64,
    "FINE_INPUT_CONTINUOUS": 1,
    "LIVE_PARAMS_READONLY": 1,
    "ASYNC_HOST_NOTIFY": 1,
    "DISPLAY_REV_THREAD": 1,
    "FINE_TRACK_RAW_INPUT": 1,
    "DISPLAY_REV_NO_UPDATE": 1,
    "ASYNC_IDLE_NOTIFY": 1
  },
  "build": {
    "root": ".",
    "sources": [
      "src/engine.cpp",
      "src/dsp/open303/GlobalFunctions.cpp",
      "src/dsp/open303/dfl_DiodeLadderFilter.cpp",
      "src/dsp/open303/dfl_LFO.cpp",
      "src/dsp/open303/rosic_AcidPattern.cpp",
      "src/dsp/open303/rosic_AcidSequencer.cpp",
      "src/dsp/open303/rosic_AnalogEnvelope.cpp",
      "src/dsp/open303/rosic_BiquadFilter.cpp",
      "src/dsp/open303/rosic_BlendOscillator.cpp",
      "src/dsp/open303/rosic_Complex.cpp",
      "src/dsp/open303/rosic_DecayEnvelope.cpp",
      "src/dsp/open303/rosic_EllipticQuarterBandFilter.cpp",
      "src/dsp/open303/rosic_FourierTransformerRadix2.cpp",
      "src/dsp/open303/rosic_FunctionTemplates.cpp",
      "src/dsp/open303/rosic_LeakyIntegrator.cpp",
      "src/dsp/open303/rosic_MidiNoteEvent.cpp",
      "src/dsp/open303/rosic_MipMappedWaveTable.cpp",
      "src/dsp/open303/rosic_NumberManipulations.cpp",
      "src/dsp/open303/rosic_OnePoleFilter.cpp",
      "src/dsp/open303/rosic_Open303.cpp",
      "src/dsp/open303/rosic_RealFunctions.cpp",
      "src/dsp/open303/rosic_TeeBeeFilter.cpp",
      "src/drive/Drive.cpp",
      "src/drive/RNNAccelerated.cpp",
      "build/model_data.cpp",
      "src/ModernVoice.cpp",
      "src/dsp/v014/open303/dfl_ARP4075Filter.cpp",
      "src/dsp/v014/open303/dfl_BlendOscillator.cpp",
      "src/dsp/v014/open303/dfl_DiodeLadderFilter.cpp",
      "src/dsp/v014/open303/dfl_LFO.cpp",
      "src/dsp/v014/open303/dfl_MS20Filter.cpp",
      "src/dsp/v014/open303/dfl_RolandFilter.cpp",
      "src/dsp/v014/open303/dfl_SEMFilter.cpp",
      "src/dsp/v014/open303/dfl_WaspFilter.cpp",
      "src/dsp/v014/open303/rosic_AcidPattern.cpp",
      "src/dsp/v014/open303/rosic_AcidSequencer.cpp",
      "src/dsp/v014/open303/rosic_AnalogEnvelope.cpp",
      "src/dsp/v014/open303/rosic_BiquadFilter.cpp",
      "src/dsp/v014/open303/rosic_Complex.cpp",
      "src/dsp/v014/open303/rosic_DecayEnvelope.cpp",
      "src/dsp/v014/open303/rosic_EllipticQuarterBandFilter.cpp",
      "src/dsp/v014/open303/rosic_FourierTransformerRadix2.cpp",
      "src/dsp/v014/open303/rosic_FunctionTemplates.cpp",
      "src/dsp/v014/open303/rosic_LeakyIntegrator.cpp",
      "src/dsp/v014/open303/rosic_MidiNoteEvent.cpp",
      "src/dsp/v014/open303/rosic_MipMappedWaveTable.cpp",
      "src/dsp/v014/open303/rosic_NumberManipulations.cpp",
      "src/dsp/v014/open303/rosic_OnePoleFilter.cpp",
      "src/dsp/v014/open303/rosic_Open303.cpp",
      "src/dsp/v014/open303/rosic_RealFunctions.cpp",
      "src/dsp/v014/open303/rosic_TeeBeeFilter.cpp"
    ],
    "cflags": [
      "-std=c++20",
      "-Ivendor/math_approx/include",
      "-Ivendor/RTNeural",
      "-Ivendor/xsimd/include",
      "-Isrc/drive"
    ],
    "libs": [
      "-lm"
    ]
  },
  "title_font": "art/DejaVuSans.ttf",
  "programs": {
    "param": "preset"
  },
  "tile": "art/browser-tile.png"
}
