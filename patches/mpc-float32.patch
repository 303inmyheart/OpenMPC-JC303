new file mode 100644
index 0000000..db592c3
--- /dev/null
+++ b/wrapper/audio_format.h
@@ -0,0 +1,18 @@
+/* Engine audio format. All translation units must use the same ENGINE_FLOAT32 setting
+ * (include the generated params.h before engine.h). Existing ports default to int16.
+ * Float ports keep headroom and quiet signals without clipping or quantisation. */
+#pragma once
+#include <stdint.h>
+#include <math.h>
+#if defined(ENGINE_FLOAT32) && ENGINE_FLOAT32
+typedef float mpc_sample_t;
+#define MPC_AUDIO_SCALE 1.0f
+static inline mpc_sample_t mpc_from_float(float f) { return f; }
+#else
+typedef int16_t mpc_sample_t;
+#define MPC_AUDIO_SCALE (1.0f / 32768.0f)
+static inline mpc_sample_t mpc_from_float(float f) {
+    f *= 32768.0f;
+    return f >= 32767.0f ? 32767 : f <= -32768.0f ? -32768 : (int16_t)lrintf(f);
+}
+#endif
